ErrorDocument 404 /404.html

# Same behavior as on Vercel: /en and /en/ both answer 200 (no 301 to the slash form)
DirectorySlash Off

RewriteEngine On

# Canonical host is www (308 keeps method, path and query string)
RewriteCond %{HTTP_HOST} =cascade.coop [NC]
RewriteRule ^ https://www.cascade.coop%{REQUEST_URI} [R=308,L,QSA]

# /en -> /en/index.html, /en/ -> /en/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*?)/?$ $1/index.html [L]
